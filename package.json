{
  "name": "@state-gallery/review",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexDistill/state-gallery.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "state-gallery": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/cli/client.d.ts",
      "import": "./dist/cli/client.js",
      "default": "./dist/cli/client.js"
    },
    "./manifest": {
      "types": "./dist/shared/schema.d.ts",
      "import": "./dist/shared/schema.js",
      "default": "./dist/shared/schema.js"
    },
    "./capture": "./dist/capture/playwright.js",
    "./importers": "./dist/importers/index.js"
  },
  "files": [
    "dist",
    "public",
    "prepare.mjs",
    "docs/integration.md",
    "docs/capture.md",
    "docs/agent-integration.md",
    "docs/self-hosting.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node prepare.mjs",
    "dev": "tsx src/server/index.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "tsx scripts/demo.ts",
    "smoke:package": "tsx scripts/package-smoke.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.35.5",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.7"
  },
  "peerDependencies": {
    "playwright-core": ">=1.55.1"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
